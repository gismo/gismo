    <!-- Monitor function -->
    <Function type="FunctionExpr" label="function" dim="3">
    u:=atan2(y,x);
    v:=atan2(sqrt(x^2+y^2),z);
    w:=sqrt(x^2+y^2+z^2);
    t:=0.05;
    tanh((1/2-v)/t) + 1
    </Function>


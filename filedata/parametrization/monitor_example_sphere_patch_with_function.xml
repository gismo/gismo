<?xml version="1.0" encoding="UTF-8"?>
<xml>

    <!-- Geometry domain -->
    <MultiPatch parDim="2" label="geometry">
        <patches type="id_range">500 500</patches>
        <!-- <interfaces>
            500 1 500 2 0 1 1 1
        </interfaces>
        <boundary>
            500 3
            500 4
        </boundary> -->
    </MultiPatch>

    <!-- Composition domain -->
    <MultiPatch parDim="2" label="composition">
        <patches type="id_range">600 600</patches>
    </MultiPatch>

    <!-- Monitor function -->
    <Function type="FunctionExpr" label="function" dim="3">
    u:=atan2(y,x);
    v:=atan2(sqrt(x^2+y^2),z);
    w:=sqrt(x^2+y^2+z^2);
    t:=0.01;
    tanh((1/2-v)/t) + 1
    </Function>

    <!-- <Function type="FunctionExpr" label="function" dim="3">
    u:=atan2(y,x);
    v:=atan2(sqrt(x^2+y^2),z);
    w:=sqrt(x^2+y^2+z^2);
    t:=100;
    exp(-t*(v - 1/2)^2)
    </Function> -->


    <!-- Assembler options -->
    <OptionList label="optimizer_options">
        <int  label="MaxIterations"     desc="" value="1000"/>
        <int  label="Verbose"           desc="" value="1"/>
        <real label="GradErrTol"        desc="" value="1e-6"/>
    </OptionList>


    <!-- Assembler options -->
    <OptionList label="parametrization_options">
        <bool label="Slide"             desc="" value="0"/>
        <bool label="Parametric"        desc="" value="0"/>
        <real label="Smoothing"         desc="" value="1e1"/>
        <real label="Penalty"           desc="" value="1e-4"/>
    </OptionList>

    <!-- 2026-08-19: driver method options (rh-driver-unification's 27-key
         table) for l2projection_rh_schedule_example, bundled here (id=4,
         same convention as the poisson driver's -f PDE files) so -f ALONE
         (no --options) fully determines a run's method options too.
         MonitorMode=gradient matches the driver's own built-in default
         (RingMonitor supplies exact value/gradient/Hessian, unlike
         poisson's discrete FE solution) -- kept explicit, not omitted, so
         this file is a complete, readable record of what a run actually
         used. NOTE: the pre-existing "optimizer_options"/
         "parametrization_options" labelled blocks above are LEGACY and
         still IGNORED by this driver (see the file header note printed at
         load time) -- id=4 below is the block this driver actually reads. -->
    <OptionList id="4">
        <string label="MonitorMode"    desc="R step monitor: value | gradient" value="gradient"/>
        <string label="Optimizer"      desc="R/D-step optimizer backend: gsOptim | HLBFGS" value="gsOptim"/>
        <int    label="RefineRule"     desc="gsHElementMarker refinement rule (1=GARU,2=PUCA,3=BULK)" value="3"/>
        <int    label="CoarsenRule"    desc="gsHElementMarker coarsening rule" value="3"/>
        <int    label="MaxLevel"       desc="gsHElementMarker level cap" value="10"/>
        <int    label="MaxRefIt"       desc="H band: inner adapt iterations per H step" value="1"/>
        <int    label="MaxIterations"  desc="R/D-step optimizer iterations" value="100"/>
        <int    label="Verbose"        desc="R/D-step optimizer verbosity" value="0"/>
        <int    label="DirSkip"        desc="D-step direction skip -- IGNORED, not implemented in this driver's D step" value="0"/>
        <int    label="RingAxis"       desc="ambient axis the two centres separate along: 0=x,1=y,2=z" value="0"/>
        <real   label="RefineParam"    desc="gsHElementMarker refinement parameter" value="0.5"/>
        <real   label="CoarsenParam"   desc="gsHElementMarker coarsening parameter" value="0.1"/>
        <real   label="Smoothing"      desc="R step: Winslow smoothing theta" value="1"/>
        <real   label="Penalty"        desc="R step: fold penalty" value="0.001"/>
        <real   label="Target"         desc="H band: target L2 error (&lt;0 disables the band); overridden per run by --target" value="-1"/>
        <real   label="Band"           desc="H band: dead-zone width factor (&gt;=1)" value="2"/>
        <real   label="NoCoarsenBelow" desc="H band: below this L2 error, hold; auto-derived from --target as Target/Band^2" value="0"/>
        <real   label="OptTol"         desc="R/D-step optimizer gradient tolerance (unified name)" value="1e-4"/>
        <real   label="quA"            desc="quadrature points-per-direction factor (error evaluators + gsAdaptiveParametrization)" value="2"/>
        <real   label="BarrierMu"      desc="D-step fold-barrier weight" value="1000"/>
        <real   label="BarrierEps"     desc="D-step fold-barrier floor" value="0.05"/>
        <real   label="Lambda"         desc="gsFitting smoothing weight -- IGNORED, no gsFitting in this driver" value="1e-06"/>
        <real   label="RingRadius"     desc="ring radius R" value="0.25"/>
        <real   label="RingWidth"      desc="ring front width w" value="0.05"/>
        <real   label="RingCx0"        desc="initial ring centre offset from the patch midpoint" value="0.30"/>
        <int    label="quB"            desc="quadrature extra points per direction -- IGA error/assembly quadrature" value="2"/>
        <bool   label="Coarsen"        desc="enable coarsening in the H step; overridden per run by --coarsen" value="0"/>
        <bool   label="Admissible"     desc="gsHElementMarker admissible closure" value="1"/>
        <bool   label="Extension"      desc="gsHElementMarker box extension" value="1"/>
        <bool   label="Slide"          desc="sigma boundary control points may slide" value="1"/>
        <bool   label="SameElement"    desc="quadrature: integration/analysis elements assumed to coincide -- must stay false under the sigma composition" value="0"/>
    </OptionList>


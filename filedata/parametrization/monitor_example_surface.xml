<?xml version="1.0" encoding="UTF-8"?>
<xml>

    <!-- Geometry domain -->
    <MultiPatch parDim="2" label="geometry">
        <patches type="id_range">500 500</patches>
        <!-- <interfaces>
            500 1 500 2 0 1 1 1
        </interfaces>
        <boundary>
            500 3
            500 4
        </boundary> -->
    </MultiPatch>

    <!-- Composition domain -->
    <MultiPatch parDim="2" label="composition">
        <patches type="id_range">600 600</patches>
    </MultiPatch>

    <!-- Monitor function -->

    <!-- <Function type="FunctionExpr" label="function" dim="3">1</Function> -->
    <!-- <Function type="FunctionExpr" label="function" dim="3">tanh((0.25-sqrt(x^2+y^2))/0.05)+1</Function> -->
    <!-- <Function type="FunctionExpr" label="function" dim="3">1 + 50 * exp( -50 * abs( (x-0.5)^2 + (y-0.5)^2 - 0.09 ) ) </Function> -->
    <!-- <Function type="FunctionExpr" label="function" dim="3">1 /(2 + cos( 8 * pi * (sqrt( (x-0.5)^2 + (y-0.5)^2 )))) </Function> -->
    <!-- <Function type="FunctionExpr" label="function" dim="3">1 + 9/(1 + ( 10 * (sqrt( (x-0.7)^2 + (y-0.5)^2 )) * cos((atan2((y-0.5),(x-0.7))) - 20 * (sqrt( (x-0.7)^2 + (y-0.5)^2 ))^2 ) )^2)</Function> -->

    <Function type="FunctionExpr" label="function" dim="3">sin(3*pi*(sqrt((x - 0.5)^2 + (y - 0.5)^2) - 1/6))^2*exp(-162*(sqrt((x - 0.5)^2 + (y - 0.5)^2) - 1/3)^2) </Function>


    <!-- Assembler options -->
    <OptionList label="optimizer_options">
        <int  label="MaxIterations"     desc="" value="1000"/>
        <int  label="Verbose"           desc="" value="1"/>
        <real label="GradErrTol"        desc="" value="1e-6"/>
    </OptionList>


    <!-- Assembler options -->
    <OptionList label="parametrization_options">
        <bool label="Slide"             desc="" value="1"/>
        <bool label="Parametric"        desc="" value="0"/>
        <real label="Smoothing"         desc="" value="1e1"/>
        <real label="Penalty"           desc="" value="1e-4"/>
    </OptionList>

    <!-- other options -->

    <!-- Geometry data -->
    <Geometry type="TensorBSpline2" id="500">
        <Basis type="TensorBSplineBasis2">
            <Basis type="BSplineBasis" index="0">
                <KnotVector degree="2">0 0 0 1 1 1 </KnotVector>
            </Basis>
            <Basis type="BSplineBasis" index="1">
                <KnotVector degree="2">0 0 0 1 1 1 </KnotVector>
            </Basis>
        </Basis>
        <coefs geoDim="3">
            0 0 0.5
            0.5 0 1
            1 0 0.5
            0 0.5 1
            0.5 0.5 1.5
            1 0.5 1
            0 1 0.5
            0.5 1 1
            1 1 0.5
        </coefs>
    </Geometry>
    <!-- Composition data -->
    <Geometry type="TensorBSpline2" id="600">
        <Basis type="TensorBSplineBasis2">
            <Basis type="BSplineBasis" index="0">
                <KnotVector degree="1">0.00000   0.00000   1.00000   1.00000</KnotVector>
            </Basis>
            <Basis type="BSplineBasis" index="1">
                <KnotVector degree="1">0.00000   0.00000   1.00000   1.00000</KnotVector>
            </Basis>
        </Basis>
        <coefs geoDim="2">
        0 0
        1 0
        0 1
        1 1
        </coefs>
    </Geometry>
</xml>

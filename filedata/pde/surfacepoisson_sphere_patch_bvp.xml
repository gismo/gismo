    u:=atan2(y,x);
    v:=atan2(sqrt(x^2+y^2),z);
    w:=sqrt(x^2+y^2+z^2);
    t:=0.05;
    tanh((1/2 - v)/t) + 1
    </Function>

    <bc type="Dirichlet" function="0" unknown="0" >
    0 1
    0 2
    0 3
    0 4
    </bc>
  </boundaryConditions>

  <!-- The manufactured exact solution (for reference) -->

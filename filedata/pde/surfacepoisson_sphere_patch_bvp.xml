  <!-- Right-hand side function -->
  <Function type="FunctionExpr" id="1" dim="3">
    u:=atan2(y,x);
    v:=atan2(sqrt(x^2+y^2),z);
    w:=sqrt(x^2+y^2+z^2);
    t:=0.05;
    -(-cos(v)*(1 - tanh((1/2 - v)/t)^2)/t - 2*sin(v)*tanh((1/2 - v)/t)*(1 - tanh((1/2 - v)/t)^2)/t^2)/(w^2*sin(v))
  </Function>


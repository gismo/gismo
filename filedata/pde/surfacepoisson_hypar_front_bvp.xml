  <!-- Hyperbolic paraboloid geometry: degree-2 TensorBSpline in R^3, z = s^2 - t^2.
       In the quadratic Bernstein basis, s has coefficients a=(0,1/2,1) and s^2
       has coefficients (0,0,1): check (1/2)*2s(1-s) + 1*s^2 = s. Since
       z(s,t) = s^2 - t^2 is a sum of a pure function of s and a pure function
       of t, and sum_j B_j(t) = 1 (partition of unity), the tensor-product
       Bezier coefficients are c_ij = a_i - a_j with a = (0,0,1) (the s^2
       coefficients), independent of the (1/2,1/2,... ) linear term. Corner
       values: (s,t)=(1,0)->z=1, (0,1)->z=-1, (1,1)->z=0. -->
  <Geometry type="TensorBSpline2" id="500">
    <Basis type="TensorBSplineBasis2">
      <Basis type="BSplineBasis" index="0">
        <KnotVector degree="2">0 0 0 1 1 1</KnotVector>
      </Basis>
      <Basis type="BSplineBasis" index="1">
        <KnotVector degree="2">0 0 0 1 1 1</KnotVector>
      </Basis>
    </Basis>
    <coefs geoDim="3">
      0    0    0
      0.5  0    0
      1    0    1
      0    0.5  0
      0.5  0.5  0
      1    0.5  1
      0    1   -1
      0.5  1   -1
      1    1    0
    </coefs>
  </Geometry>


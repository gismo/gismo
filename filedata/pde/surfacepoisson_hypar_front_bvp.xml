<?xml version="1.0" encoding="UTF-8"?>
<xml>

  <!-- Hyperbolic paraboloid surface: r(s,t) = (s, t, s^2 - t^2)
       Manufactured solution: u = 1 - tanh(-5 + 20*sqrt((-1/2 + x)^2 + (-1/2 + y)^2))
       (x=s, y=t): the SAME tanh front as surfacepoisson_paraboloid_front_bvp.xml,
       so the two BVPs differ ONLY in geometry.  That isolates the curvature effect:
       the paraboloid is convex (bowl), the hyperbolic paraboloid is a saddle
       (Gaussian curvature < 0 everywhere), while the front profile, boundary
       data and exact solution are byte-identical between the two files.

       The source is -Delta_Gamma u for THIS surface, derived by
       scripts/derive_surface_rhs.py from the general first-fundamental-form
       operator Delta_Gamma u = (1/sqrt(g)) d_i( sqrt(g) g^ij d_j u ), which for
       a graph z(s,t) reduces (checked symbolically by the script) to
       (1/q) div( q (grad u - (grad z . grad u) grad z / q^2) ), q = sqrt(1+z_s^2+z_t^2).
       The derivation was checked by reproducing the u = x closed form
       -4a(q^2+1)/q^4 on the paraboloid, and by comparing against a
       finite-difference Laplace-Beltrami at 200 random points for this front
       profile on z = s^2 - t^2 specifically.
       Do NOT substitute a planar -Delta u here: on a curved surface that is a
       geometry/source mismatch and the error will stagnate. -->

  <!-- Computational domain (id=0) -->
  <MultiPatch parDim="2" id="0">
    <patches type="id_range">500 500</patches>
    <interfaces/>
    <boundaries name="dirichlet">
      500 1
      500 2
      500 3
      500 4
    </boundaries>
  </MultiPatch>

  <!-- Right-hand side: -Delta_Gamma u  (id=1, physical coords in R^3) -->
  <Function type="FunctionExpr" id="1" dim="3">-(-40 - 2560*x^6 - 2560*y^6 - 2240*x^4 - 2240*y^4 - 320*x^2 - 320*y^2 + 40*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 80*x + 80*y + 960*x^3 + 960*y^3 + 3200*x^5 + 3200*y^5 - 3200*x^5*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 3200*y^5*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 2560*x^2*y^3 - 2560*x^3*y^2 - 960*x^3*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 960*y^3*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 800*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 640*x*y^4 - 640*y*x^4 - 320*x*y^2 - 320*y*x^2 - 80*x*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 80*y*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 160*x*y + 320*x^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 320*y^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 640*x*y^3 + 640*y*x^3 + 800*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 1920*x^2*y^2 + 2240*x^4*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 2240*y^4*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 2560*x^2*y^4 + 2560*x^4*y^2 + 2560*x^6*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 2560*y^6*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 12800*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 12800*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 6400*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 6400*x^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 6400*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 6400*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 2560*x^2*y^4*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 2560*x^4*y^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 1920*x^2*y^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 1600*x*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 1600*y*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 640*x*y^3*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 640*y*x^3*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 - 160*x*y*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 320*x*y^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 320*y*x^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 640*x*y^4*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 640*y*x^4*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 1600*x*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 1600*y*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 2560*x^2*y^3*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 2560*x^3*y^2*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^2 + 6400*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 6400*x^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 6400*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 6400*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 12800*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 12800*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 102400*x^2*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 102400*x^4*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 51200*x*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 51200*y*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 51200*x^2*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 51200*x^2*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 51200*x^3*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 19200*x*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 19200*y*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) - 12800*x*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 12800*y*x^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 - 3200*x*y*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 3200*x*y*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 12800*x*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 12800*y*x^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 19200*x*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 19200*y*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 51200*x*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 51200*y*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 51200*x^2*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 51200*x^2*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 51200*x^3*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))^3 + 102400*x^2*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)) + 102400*x^4*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)*tanh(-5 + 10*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2)))/(sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 32*x^5*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 32*y^5*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 16*x^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 16*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 2*x*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 2*y*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 10*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 10*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 32*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 32*x^6*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 32*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 32*y^6*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 64*x^2*y^3*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 64*x^3*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 32*x*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 32*y*x^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 16*x*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) - 16*y*x^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 64*x^2*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 96*x^2*y^4*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2) + 96*x^4*y^2*sqrt(2 - 4*x - 4*y + 4*x^2 + 4*y^2))</Function>

  <!-- Boundary conditions: the tanh front on all four sides (id=2) -->
  <boundaryConditions id="2" multipatch="0">
    <Function type="FunctionExpr" dim="3" index="0">1 - tanh(-5 + 20*sqrt((-1/2 + x)^2 + (-1/2 + y)^2))</Function>
    <bc type="Dirichlet" function="0" unknown="0">
      0 1
      0 2
      0 3
      0 4
    </bc>
  </boundaryConditions>

  <!-- Exact solution (id=3) -->
  <Function type="FunctionExpr" id="3" dim="3">1 - tanh(-5 + 20*sqrt((-1/2 + x)^2 + (-1/2 + y)^2))</Function>


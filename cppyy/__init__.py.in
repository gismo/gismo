    License, v. 2.0. If a copy of the MPL was not distributed with this
    file, You can obtain one at http://mozilla.org/MPL/2.0/.

    Author(s): F. Scholz
"""

import os
# When the library is compiled without AVX but Cling's JIT auto-detects
# it on the host CPU, Eigen SIMD code paths diverge causing ABI mismatches.
# EIGEN_DONT_VECTORIZE forces scalar code in JIT; the library's own
# pre-compiled vectorized code is unaffected.
_cling_flags = '@GISMO_CLING_FLAGS@'
if _cling_flags:
    os.environ['EXTRA_CLING_ARGS'] = os.environ.get('EXTRA_CLING_ARGS', '') + ' ' + _cling_flags

import cppyy
import builtins
from .pythonize import pythonize_gismo

includedirs = '@GISMO_INCLUDE_DIRS@'.split(";")
libdir = '@GISMO_LIB_DIR@'

cppyy.add_library_path(libdir)
for dir in includedirs:
    cppyy.add_include_path(dir)

cppyy.include("gismo.h")
cppyy.load_library("gismo")

cppyy.py.add_pythonization(pythonize_gismo, scope="gismo")

gismo = cppyy.gbl.gismo
builtins.__dict__["gismo"] = gismo

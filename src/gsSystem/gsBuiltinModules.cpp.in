#include <gsCore/gsDebug.h>
#include <gsSystem/gsModule.h>
#include <cstring>

@GISMO_BUILTIN_MODULE_DECLS@
namespace gismo
{

const char * const * gsBuiltinModuleNames()
{
    static const char * const names[] = { @GISMO_BUILTIN_MODULE_NAMES@NULL };
    return names;
}

bool gsRegisterBuiltinModule(const char * name)
{
    GISMO_UNUSED(name);
@GISMO_BUILTIN_MODULE_CALLS@    return false;
}

void gsRegisterBuiltinModules()
{
    for (const char * const * n = gsBuiltinModuleNames(); *n != NULL; ++n)
        gsRegisterBuiltinModule(*n);
}

} // namespace gismo

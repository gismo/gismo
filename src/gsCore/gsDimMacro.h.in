#pragma once

#include <gsCore/gsConfig.h>

/**
 * @brief Expands to X(1) X(2) ... X(GISMO_MAX_DIMENSION)
 *
 * Useful for explicit template instantiation in _.cpp files:
 * @code
 * #define INST(D) CLASS_TEMPLATE_INST MyClass<D,real_t>;
 * GISMO_DIM_FOREACH(INST)
 * #undef INST
 * @endcode
 */
#define GISMO_DIM_FOREACH(X) @GISMO_DIM_FOREACH_BODY@

/**
 * @brief Expands to X(2) X(3) ... X(GISMO_MAX_DIMENSION)
 *
 * Like GISMO_DIM_FOREACH but starts at dimension 2.
 * Useful for tensor-product types that require at least 2 dimensions.
 */
#define GISMO_DIM_FOREACH_FROM2(X) @GISMO_DIM_FOREACH_FROM2_BODY@
